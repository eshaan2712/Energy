# ============================================
# PYTHON MODELS CONFIGURATION
# ============================================
PYTHON_PATH=/usr/bin/python3
PYTHON_MODELS_DIR=./python_models
MODELS_TIMEOUT=300
ENABLE_ARIMA=true
ENABLE_LSTM=true
ENABLE_PROPHET=true

# Model Prediction Parameters
FORECAST_STEPS=14
CONFIDENCE_INTERVAL=0.95
TRAIN_TEST_SPLIT=0.8
